FROM node:22-bookworm-slim
ARG CODEX_VERSION=0.157.0
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates git && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/python && /opt/python/bin/pip install --no-cache-dir numpy scipy pillow opencv-python-headless
RUN npm install -g @openai/codex@${CODEX_VERSION}
ENV PATH="/opt/python/bin:${PATH}" HOME=/tmp CODEX_HOME=/tmp/codex
WORKDIR /work
